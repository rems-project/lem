(* Failure probe (census N4, conversion leg) — a RULED OCaml-TARGET
   DEVIATION since 2026-09-04 (parity/expected_failures.txt): the OCaml
   reference's natFromNatural / intFromInteger are Nat_big_num.to_int,
   which raises Failure "int_of_big_int" at 2^62 (the 63-bit OCaml int
   range); lem's nat/int are unbounded (num.lem:104-111, prover-side
   semantics) and the Lean conversions are the identity — [USER
   2026-09-03] ruled that hard-coded OCaml limits arising from OCaml-level
   execution are forbidden too; the logical semantics is what counts. The runner therefore EXPECTS this probe to fail parity
   (Lean succeeds where the OCaml reference raises); until 2026-09-04 the
   Lean side failed loudly at the same bound (parity-fix slice 3c88f0d,
   exception-case rulings X3 — superseded by the X3 addendum). *)
open import Pervasives_extra

let steps : list (nat -> string) =
  [ (fun n -> "before: 2^62-1 -> " ^ stringFromNat (natFromNatural (naturalPow 2 62 - 1 - naturalFromNat n)));
    (fun n -> "before int: " ^ stringFromInt (intFromInteger (0 - integerPow 2 62 + integerFromNat n)));
    (fun n -> "at 2^62: " ^ stringFromNat (natFromNatural (naturalPow 2 62 + naturalFromNat n))) ]
