(* Failure probe (census N3, the checked conversions) — a RULED
   OCaml-TARGET DEVIATION since 2026-09-04 (parity/expected_failures.txt):
   Nat_big_num.to_int32 (int32FromInteger / int32FromNatural / int32
   numerals) raises Z.Overflow outside [-2^31, 2^31-1] on the OCaml
   target; lem's OWN semantics of these conversions is modular
   (`word_of_int` / `n2w`, library/num.lem:831-832, :2378-2396), so the
   Lean conversions WRAP (Int32.ofInt / Int32.ofNat) and this probe is
   REQUIRED to fail parity (Lean succeeds where the OCaml reference
   raises) — [USER 2026-09-04] adopting the fuel-parameter record's D4
   recommendation; doc/lean-backend/2026-09-03_exception-case-rulings.md
   D4 addendum. Until 2026-09-04 the Lean side (lemInt32OfIntegerExact)
   failed loudly at the same bound (parity-fix slice 3c88f0d). The
   in-range conversions and the WRAPPING ones (Int32.of_int) are pinned
   by the success probe p_int_wrap.lem. *)
open import Pervasives_extra

let steps : list (nat -> string) =
  [ (fun n -> "before: in range: " ^ show (integerFromInt32 (int32FromInteger (2147483647 - integerFromNat n))));
    (fun n -> "at overflow: " ^ show (integerFromInt32 (int32FromInteger (2147483648 + integerFromNat n)))) ]
