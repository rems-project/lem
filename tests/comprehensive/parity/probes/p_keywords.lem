(* Noodle probe: identifiers that are Lean keywords / core names (lowercase; OCaml
   keywords and capitalised names are excluded — lem itself emits invalid
   OCaml for those) / carry primes, used as values, parameters,
   fields, constructors and local binders. Emission must stay valid Lean
   and mean the same thing. Expected values are the OCaml target's output. *)
open import Pervasives_extra

let from (x : nat) : nat = x + 1
let at (x : nat) : nat = x + 2
let by (x : nat) : nat = x + 3
let where (x : nat) : nat = x + 6
let have (x : nat) : nat = x + 7
let deriving (x : nat) : nat = x + 8
let namespace (x : nat) : nat = x + 9
let section (x : nat) : nat = x + 10
let variable (x : nat) : nat = x + 11
let universe (x : nat) : nat = x + 12
let axiom (x : nat) : nat = x + 13
let abbrev (x : nat) : nat = x + 14
let structure (x : nat) : nat = x + 15
let inductive (x : nat) : nat = x + 16
let mutual (x : nat) : nat = x + 17
let partial (x : nat) : nat = x + 18
let def (x : nat) : nat = x + 19
let example (x : nat) : nat = x + 20
let calc (x : nat) : nat = x + 21
let this (x : nat) : nat = x + 22
let sorry (x : nat) : nat = x + 23
let default (x : nat) : nat = x + 24
let panic (x : nat) : nat = x + 25
let some (x : nat) : nat = x + 26
let none (x : nat) : nat = x + 27
let id (x : nat) : nat = x + 28
let max (x : nat) : nat = x + 29
let min (x : nat) : nat = x + 30
let compare (x : nat) : nat = x + 31
let protected (x : nat) : nat = x + 33
let unsafe (x : nat) : nat = x + 34
let opaque (x : nat) : nat = x + 35
let local (x : nat) : nat = x + 36
let macro (x : nat) : nat = x + 37
let syntax (x : nat) : nat = x + 38
let notation (x : nat) : nat = x + 39
let prefix (x : nat) : nat = x + 41
let omit (x : nat) : nat = x + 42
let nomatch (x : nat) : nat = x + 44
let nofun (x : nat) : nat = x + 45
let noncomputable (x : nat) : nat = x + 46
let termination_by (x : nat) : nat = x + 47
let decreasing_by (x : nat) : nat = x + 48
let set_option (x : nat) : nat = x + 49
let elab (x : nat) : nat = x + 50
let attribute (x : nat) : nat = x + 51
let instance_ (x : nat) : nat = x + 52
let lemFuel (x : nat) : nat = x + 53
let x' (x : nat) : nat = x + 54
let x'' (x : nat) : nat = x + 55
let foo_bar (x : nat) : nat = x + 56
let fooBar (x : nat) : nat = x + 57
let show_ (x : nat) : nat = x + 58
let main (x : nat) : nat = x + 59
let results_ (x : nat) : nat = x + 60
let string (x : nat) : nat = x + 61
let nat (x : nat) : nat = x + 62
let list (x : nat) : nat = x + 63
let bool (x : nat) : nat = x + 64
let unit (x : nat) : nat = x + 65
let option (x : nat) : nat = x + 66
let prod (x : nat) : nat = x + 67
let sum (x : nat) : nat = x + 68
let ordering (x : nat) : nat = x + 69
let lt (x : nat) : nat = x + 70
let eq (x : nat) : nat = x + 71
let gt (x : nat) : nat = x + 72
let inl (x : nat) : nat = x + 73
let inr (x : nat) : nat = x + 74
let fst_ (x : nat) : nat = x + 75
let cons (x : nat) : nat = x + 76
let nil (x : nat) : nat = x + 77
let pure (x : nat) : nat = x + 78
let bind (x : nat) : nat = x + 79
let return_ (x : nat) : nat = x + 80
let val_ (x : nat) : nat = x + 81
let ite (x : nat) : nat = x + 82
let dite (x : nat) : nat = x + 83
let toString_ (x : nat) : nat = x + 84
let succ (x : nat) : nat = x + 85
let zero (x : nat) : nat = x + 86
let pred (x : nat) : nat = x + 87
let length (x : nat) : nat = x + 88
let append (x : nat) : nat = x + 89
