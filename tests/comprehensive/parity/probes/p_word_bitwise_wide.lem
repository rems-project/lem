(* Parity probe for LP4 (record doc/lean-backend/
   2026-09-30_library-parity-coverage.md LP4): a RULED OCaml-target
   deviation, [USER 2026-09-30] agreed items 1-3, under the
   2026-09-03 X3 ruling; registered class `ruled`. (It was first written
   for D2's condition, which it showed unmet.) OCaml's Lem `nat`/`int` are
   native `int` (library/num.lem:117) and the reps are
   `land`/`lor`/`lxor`/`lsl`/`asr` (library/word.lem:875-1078), 63-bit. No
   arithmetic is involved: every operand is a literal inside 62 bits or the
   result of `lsl`. The PRIMITIVE divergence is `lsl` past bit 62, plus
   shifts by at least the word size (`lsl` and `asr` by 64); on
   representable operands OCaml's land/lor/lxor/asr are exact, and the
   land/lor/lxor rows only propagate an lsl-built operand that already
   differs. Rows whose wide operands are built by multiplication (the X3/N4
   arithmetic wrap) are in p_word_bitwise_wide_mul. The pin is the OCaml
   output. Control rows first (inside 62 bits). *)
open import Pervasives_extra

let p61 : int = 2305843009213693952
let si (i : int) : string = show i
let sn (n : nat) : string = show n

let results : list string =
  [ "control intLsl 1 61 = " ^ si (intLsl 1 61);
    "control natLsl 1 61 = " ^ sn (natLsl 1 61);
    "control intLor p61 1 = " ^ si (intLor p61 1);
    "intLsl 1 62 = " ^ si (intLsl 1 62);
    "intLsl 1 63 = " ^ si (intLsl 1 63);
    "intLsl 3 62 = " ^ si (intLsl 3 62);
    "intLsl 1 64 = " ^ si (intLsl 1 64);
    "intAsr (intLsl 1 63) 1 = " ^ si (intAsr (intLsl 1 63) 1);
    "natLsl 1 62 = " ^ sn (natLsl 1 62);
    "natLsl 1 63 = " ^ sn (natLsl 1 63);
    "natLsl 5 61 = " ^ sn (natLsl 5 61);
    "natAsr (natLsl 1 63) 1 = " ^ sn (natAsr (natLsl 1 63) 1);
    "intAsr 5 64 = " ^ si (intAsr 5 64);
    "intAsr (0-5) 64 = " ^ si (intAsr (0-5) 64);
    "natAsr 5 64 = " ^ sn (natAsr 5 64);
    "intLor (intLsl 1 63) 1 = " ^ si (intLor (intLsl 1 63) 1);
    "intLand (intLsl 3 62) (intLsl 1 63) = " ^ si (intLand (intLsl 3 62) (intLsl 1 63));
    "intLxor (intLsl 1 64) 1 = " ^ si (intLxor (intLsl 1 64) 1);
    "natLor (natLsl 1 63) 1 = " ^ sn (natLor (natLsl 1 63) 1);
    "natLand (natLsl 3 62) (natLsl 1 63) = " ^ sn (natLand (natLsl 3 62) (natLsl 1 63));
    "natLxor (natLsl 1 64) 1 = " ^ sn (natLxor (natLsl 1 64) 1) ]
