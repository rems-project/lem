(* EXPECT: is a projection on `q`, which is not a parameter *)
(* fuel-measure (rule shared with the hypothesis, measure-hypothesis slice):
   `q.1` when the parameter is `p` is a projection on a non-parameter, not a
   qualified global. *)
open import Pervasives
val down : nat * nat -> nat
let rec down p = let (a, step) = p in if a = 0 then 0 else 1 + down (a - step, step)
declare {lean} fuel val down = `999`
declare {lean} fuel_measure val down = `q.1 + 1`
