(* EXPECT: has no measure *)
(* measure-hypothesis slice: `assuming` qualifies a MEASURE's obligation;
   without a measure there is nothing to qualify — refused at parse with
   the reason. *)
open import Pervasives
val ndigits : nat -> nat -> nat
let rec ndigits b n = if n / b = 0 then 1 else 1 + ndigits b (n / b)
declare {lean} fuel val ndigits = `999`
declare {lean} fuel_measure val ndigits assuming `2 ≤ b`
