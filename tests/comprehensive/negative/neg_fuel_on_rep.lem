(* EXPECT: FC-inert *)
(* Fuel-parameter arc: a fuel SENTINEL on a val that carries a Lean
   target_rep is silently inert (its lem definition renders as a
   comment; no worker/wrapper is emitted) — rejected; a hand-written
   implementation that reads the ambient declares fuel_consumer. *)
open import Pervasives
val spin : nat -> nat
let rec spin n = if n = 0 then 0 else spin (n - 1)
declare lean target_rep function spin = `X.spin`
declare {lean} fuel val spin = `999`
