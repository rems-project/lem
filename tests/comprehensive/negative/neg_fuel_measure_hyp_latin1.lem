(* EXPECT: free variable `ñ` *)
(* pre-merge audit F4 (measure-hypothesis slice): a Latin-1 letter is an
   identifier character to Lean (`isLetterLike`), so `ñ` must be read as an
   identifier and refused as a free variable at generation — not passed
   through as an operator (which left the build to catch it). *)
open import Pervasives
val ndigits : nat -> nat -> nat
let rec ndigits b n = if n / b = 0 then 1 else 1 + ndigits b (n / b)
declare {lean} fuel val ndigits = `999`
declare {lean} fuel_measure val ndigits = `n + 1` assuming `2 ≤ ñ ∧ 2 ≤ b`
