(* EXPECT: reserved binder `lemFuel` *)
(* measure-hypothesis slice: the hypothesis may not mention the fuel — the
   synthesized counter binder `lemFuel` is bound AFTER `lemHyp` in the
   obligation and is not a parameter. *)
open import Pervasives
val spin : nat -> nat
let rec spin n = if n = 0 then 0 else spin (n - 1)
declare {lean} fuel val spin = `999`
declare {lean} fuel_measure val spin = `n + 1` assuming `n < lemFuel`
