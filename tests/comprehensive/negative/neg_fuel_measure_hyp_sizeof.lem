(* EXPECT: FH-sizeOf *)
(* measure-hypothesis slice: one vocabulary for measure and hypothesis —
   `sizeOf` is refused in a hypothesis as in a measure (speedbump; a
   hand-written size function is the route). *)
open import Pervasives
val len : list nat -> nat
let rec len l = match l with | [] -> 0 | _ :: xs -> 1 + len xs end
declare {lean} fuel val len = `999`
declare {lean} fuel_measure val len = `List.length l + 1` assuming `sizeOf l < 100`
