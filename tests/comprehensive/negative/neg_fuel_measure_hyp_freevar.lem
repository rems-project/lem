(* EXPECT: FH-free *)
(* measure-hypothesis slice: an unqualified identifier that is not a
   parameter (`base` when the parameter is `b`) is a free variable. *)
open import Pervasives
val ndigits : nat -> nat -> nat
let rec ndigits b n = if n / b = 0 then 1 else 1 + ndigits b (n / b)
declare {lean} fuel val ndigits = `999`
declare {lean} fuel_measure val ndigits = `n + 1` assuming `2 ≤ base`
