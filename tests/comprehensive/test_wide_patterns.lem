open import Pervasives_extra

(* ======================================================================
   Wide patterns (backend-hardening 2026-10-03, item 5). Generation time
   was exponential in the number of sibling groups on a line that
   overflows the layout width: a constructor pattern of 47 wildcards took
   over two minutes (45 took none), 150 was killed after eleven minutes. The
   cause was the layout printer re-deciding every following group once per
   consumer of a candidate line (call-by-name Seq); the candidate is now
   memoized. The suite phase lean-wide-patterns generates this file under a
   time bound; the asserts compile and check the output. The constructor
   has 120 fields: past the cliff by far, under the Lean runtime's
   128-field limit that the backend refuses (item 6, neg_variant_width_128).
   ====================================================================== *)

type wide = Wide of nat * nat * nat * nat * nat * nat * nat * nat * nat * nat * nat * nat * nat * nat * nat * nat * nat * nat * nat * nat * nat * nat * nat * nat * nat * nat * nat * nat * nat * nat * nat * nat * nat * nat * nat * nat * nat * nat * nat * nat * nat * nat * nat * nat * nat * nat * nat * nat * nat * nat * nat * nat * nat * nat * nat * nat * nat * nat * nat * nat * nat * nat * nat * nat * nat * nat * nat * nat * nat * nat * nat * nat * nat * nat * nat * nat * nat * nat * nat * nat * nat * nat * nat * nat * nat * nat * nat * nat * nat * nat * nat * nat * nat * nat * nat * nat * nat * nat * nat * nat * nat * nat * nat * nat * nat * nat * nat * nat * nat * nat * nat * nat * nat * nat * nat * nat * nat * nat * nat * nat
let mk_wide (k : nat) : wide = Wide (k + 0) (k + 1) (k + 2) (k + 3) (k + 4) (k + 5) (k + 6) (k + 7) (k + 8) (k + 9) (k + 10) (k + 11) (k + 12) (k + 13) (k + 14) (k + 15) (k + 16) (k + 17) (k + 18) (k + 19) (k + 20) (k + 21) (k + 22) (k + 23) (k + 24) (k + 25) (k + 26) (k + 27) (k + 28) (k + 29) (k + 30) (k + 31) (k + 32) (k + 33) (k + 34) (k + 35) (k + 36) (k + 37) (k + 38) (k + 39) (k + 40) (k + 41) (k + 42) (k + 43) (k + 44) (k + 45) (k + 46) (k + 47) (k + 48) (k + 49) (k + 50) (k + 51) (k + 52) (k + 53) (k + 54) (k + 55) (k + 56) (k + 57) (k + 58) (k + 59) (k + 60) (k + 61) (k + 62) (k + 63) (k + 64) (k + 65) (k + 66) (k + 67) (k + 68) (k + 69) (k + 70) (k + 71) (k + 72) (k + 73) (k + 74) (k + 75) (k + 76) (k + 77) (k + 78) (k + 79) (k + 80) (k + 81) (k + 82) (k + 83) (k + 84) (k + 85) (k + 86) (k + 87) (k + 88) (k + 89) (k + 90) (k + 91) (k + 92) (k + 93) (k + 94) (k + 95) (k + 96) (k + 97) (k + 98) (k + 99) (k + 100) (k + 101) (k + 102) (k + 103) (k + 104) (k + 105) (k + 106) (k + 107) (k + 108) (k + 109) (k + 110) (k + 111) (k + 112) (k + 113) (k + 114) (k + 115) (k + 116) (k + 117) (k + 118) (k + 119)
let wide_last (x : wide) : nat = match x with Wide _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ z -> z end
let wide_first (x : wide) : nat = match x with Wide z _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ -> z end
assert wide_last_ok : (wide_last (mk_wide 1) = (120:nat))
assert wide_first_ok : (wide_first (mk_wide 1) = (1:nat))

