assert long_first : (long_chain 0 = 1)
assert long_mid : (long_chain 40 = 281)
assert long_b63 : (long_chain 63 = 442)
assert long_b64 : (long_chain 64 = 449)
assert long_b127 : (long_chain 127 = 890)
assert long_b128 : (long_chain 128 = 897)
assert long_last : (long_chain 149 = 1044)
assert long_fallthrough : (long_chain 150 = 0)
assert nested_hit : (nested_chain (Just 130) = Just 260)
assert nested_miss : (nested_chain (Just 999) = Nothing)
assert nested_nothing : (nested_chain Nothing = Nothing)
