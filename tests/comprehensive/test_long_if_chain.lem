(* the same shape nested inside a let and a match, as in linksem *)
val nested_chain : maybe nat -> maybe nat
let nested_chain m =
  match m with
  | Nothing -> Nothing
  | Just j ->
      let k = j in
      if k = 0 then Just (k + 0)
      else if k = 1 then Just (k + 1)
      else if k = 2 then Just (k + 2)
      else if k = 3 then Just (k + 3)
      else if k = 4 then Just (k + 4)
      else if k = 5 then Just (k + 5)
      else if k = 6 then Just (k + 6)
