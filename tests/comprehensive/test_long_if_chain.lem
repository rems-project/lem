open import Pervasives_extra

(* ======================================================================
   Long if/else-if chains (linksem 2026-09-28, B3). Lean cannot elaborate
   an else-if chain nested ~128 deep; linksem's relocation dispatch has a
   123-arm chain inside a larger term. Chains longer than 96 arms are
   emitted in blocks of 64 joined by local `_lemIfTailN` continuations.
   GENERATED by hand from a script (150 arms); the asserts pin the first,
   a middle, both block boundaries (63/64, 127/128), the last arm and the
   fall-through, so a reordering or a lost arm fails the build.
   ====================================================================== *)

val long_chain : nat -> nat
let long_chain x =
  if x = 0 then 1
  else if x = 1 then 8
  else if x = 2 then 15
  else if x = 3 then 22
