def isPrefixOf { a : Type } [Eq0 a] (l1 : List a) (l2 : List a) : Bool :=
  match l1, l2 with
  | [], _ => true
  | _ :: _, [] => false
  | x :: xs, y :: ys => (x == y) && isPrefixOf xs ys

