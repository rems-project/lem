 def  zip  {a b : Type}  (l1 : List a) (l2 : List b)  : List (a ×b) :=  match l1,  l2 with  | x  ::  xs,  y  ::  ys =>  (x, y)  ::  lemListZip  xs  ys | _, _ =>  []
