/- DPM: eta-expansion for Coq backend type-inference. -/
def lookupBy { a b : Type } (eq : a → a → Bool) (k : a) (m : List (a × b)) : Option b :=
  Option.map (fun (x : (a × b)) => Prod.snd x)
    (find
      (fun (p : (a × b)) =>
        match p with
        | (k', _) => eq k k') m)

