/- Equality check          -/
/- ----------------------- -/

instance (a : Type) [SetType a] : Eq0 (Pset a) where

    isEqual := (setEqualBy (@setElemCompare a _))

    isInequal s1 s2 := not ((setEqualBy (@setElemCompare a _) s1 s2))

